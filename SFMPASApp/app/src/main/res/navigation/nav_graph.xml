<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/registrationFragment">

    <!-- 1 · Registration -->
    <fragment
        android:id="@+id/registrationFragment"
        android:name="com.sfmpas.app.ui.RegistrationFragment"
        android:label="@string/title_registration"
        tools:layout="@layout/fragment_registration">
        <!--
          Registration is popped off the stack so Back from Home exits the app
          rather than returning to a form that has already been submitted.
        -->
        <action
            android:id="@+id/action_registration_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/registrationFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- 2 · Home -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.sfmpas.app.ui.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_payment"
            app:destination="@id/paymentFragment" />
        <action
            android:id="@+id/action_home_to_self_test"
            app:destination="@id/selfTestFragment" />
    </fragment>

    <!-- 3 · Payment -->
    <fragment
        android:id="@+id/paymentFragment"
        android:name="com.sfmpas.app.ui.PaymentFragment"
        android:label="@string/title_payment"
        tools:layout="@layout/fragment_payment">
        <action
            android:id="@+id/action_payment_to_authentication"
            app:destination="@id/authenticationFragment" />
    </fragment>

    <!-- 4 · Authentication -->
    <fragment
        android:id="@+id/authenticationFragment"
        android:name="com.sfmpas.app.ui.AuthenticationFragment"
        android:label="@string/title_authentication"
        tools:layout="@layout/fragment_authentication">

        <argument
            android:name="amountNaira"
            app:argType="long" />
        <argument
            android:name="recipient"
            app:argType="string" />
        <argument
            android:name="tierName"
            app:argType="string" />

        <!--
          After a verdict the user returns to Home, and the whole payment leg
          (payment + authentication) is popped so Back cannot re-enter a
          completed authorisation.
        -->
        <action
            android:id="@+id/action_authentication_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Retained diagnostic: the PAD self-test that validated this build -->
    <fragment
        android:id="@+id/selfTestFragment"
        android:name="com.sfmpas.app.ui.SelfTestFragment"
        android:label="@string/title_self_test"
        tools:layout="@layout/fragment_self_test" />

</navigation>
